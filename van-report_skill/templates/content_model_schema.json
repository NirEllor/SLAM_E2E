{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Report Content Model",
  "description": "Structured content model for rendering report.docx/pdf and problem.pdf. Each block is either prose, citation, figure, or layout control. The model is source-of-truth; never write prose to report files directly — transcribe from model entries only.",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "type": {"const": "heading1"},
          "text": {"type": "string"},
          "ledger_ref": {"type": ["string", "null"]}
        },
        "required": ["type", "text"],
        "description": "Section heading (H1)"
      },
      {
        "type": "object",
        "properties": {
          "type": {"const": "heading2"},
          "text": {"type": "string"},
          "ledger_ref": {"type": ["string", "null"]}
        },
        "required": ["type", "text"],
        "description": "Subsection heading (H2)"
      },
      {
        "type": "object",
        "properties": {
          "type": {"const": "paragraph"},
          "text": {"type": "string"},
          "bold": {"type": "boolean"},
          "ledger_ref": {"type": ["string", "null"]}
        },
        "required": ["type", "text"],
        "description": "Paragraph of prose text"
      },
      {
        "type": "object",
        "properties": {
          "type": {"const": "code_citation"},
          "claim": {"type": "string"},
          "function": {"type": "string"},
          "file": {"type": "string"},
          "line_start": {"type": "integer"},
          "line_end": {"type": "integer"},
          "ledger_ref": {"type": "string"}
        },
        "required": ["type", "claim", "function", "file", "line_start", "line_end", "ledger_ref"],
        "description": "Code location citation (function name + file + line range)"
      },
      {
        "type": "object",
        "properties": {
          "type": {"const": "figure"},
          "artifact_path": {"type": "string"},
          "caption": {"type": "string"},
          "ledger_ref": {"type": "string"}
        },
        "required": ["type", "artifact_path", "caption", "ledger_ref"],
        "description": "Figure: embedded image with caption and code generation location"
      },
      {
        "type": "object",
        "properties": {
          "type": {"const": "table"},
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {"type": "string"}
            }
          },
          "caption": {"type": ["string", "null"]},
          "ledger_ref": {"type": ["string", "null"]}
        },
        "required": ["type", "rows"],
        "description": "Table: rows of strings (cells)"
      },
      {
        "type": "object",
        "properties": {
          "type": {"const": "bullet_list"},
          "items": {
            "type": "array",
            "items": {"type": "string"}
          },
          "ledger_ref": {"type": ["string", "null"]}
        },
        "required": ["type", "items"],
        "description": "Bullet list"
      },
      {
        "type": "object",
        "properties": {
          "type": {"const": "section_break"}
        },
        "required": ["type"],
        "description": "Page break"
      },
      {
        "type": "object",
        "properties": {
          "type": {"const": "gap"},
          "status": {"enum": ["TRUE_GAP", "CUT_FOR_SPACE"]},
          "id": {"type": "string"},
          "claim": {"type": "string"},
          "reason": {"type": "string"}
        },
        "required": ["type", "status", "id", "claim"],
        "description": "Unverified or cut requirement — goes to problem.pdf, not main report"
      }
    ]
  },
  "examples": [
    {
      "type": "heading1",
      "text": "1. Introduction and Overview"
    },
    {
      "type": "paragraph",
      "text": "Stereo visual navigation is a technique for estimating the pose and trajectory of a camera moving through a 3D scene using images captured by a stereo camera pair."
    },
    {
      "type": "code_citation",
      "claim": "Stereo triangulation of matched keypoints into 3D points",
      "function": "triangulate_points",
      "file": "code/project/utils/geometry.py",
      "line_start": 42,
      "line_end": 78,
      "ledger_ref": "STAGE-01-TRIANGULATION"
    },
    {
      "type": "figure",
      "artifact_path": "code/project/outputs/task_summary_full_trajectory_comparison.png",
      "caption": "Trajectory comparison (bird's-eye view): Ground truth (green), PnP (blue), Bundle (orange), Pose Graph (red), Pose Graph + Loop Closure (purple). Generated by plot_full_trajectory_comparison() at code/project/utils/visualization.py:L456.",
      "ledger_ref": "GRAPH-TRAJECTORY-COMPARISON"
    },
    {
      "type": "section_break"
    }
  ]
}